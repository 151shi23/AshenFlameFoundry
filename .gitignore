# ============================================================
#  Mineways Mobile —— 版本库忽略规则
#  开源版**不收录任何编译好的 APK / AAB**，也不收录签名密钥。
#  Open-source version ships **no prebuilt APK/AAB** and no signing keys.
# ============================================================

# ---- 编译产物：APK / AAB / 中间产物（开源版一律不入库）----
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
build/
*/build/
**/build/
.gradle/
.cxx/
obj/
libs/
outputs/
release/
debug/
captures/
*.hprof

# ---- 签名与密钥：绝不入库（assembleRelease 请自备 keystore）----
*.jks
*.keystore
*.p12
*.pem
*.der
keystore.properties
signing.properties
产物/

# ---- 本机/环境相关（路径、代理等）----
local.properties
android-env.sh
*.log
*.bak
*.tmp

# ---- 工具备份与临时文件 ----
tools/_backup/
tools/__pycache__/
__pycache__/
*.pyc
*.orig
*.rej

# ---- IDE / 系统 ----
.idea/
*.iml
.vscode/
.settings/
.project
.DS_Store
Thumbs.db

# ---- 导出、运行期产物 ----
导出报错/
预览缓存/

# ============================================================
#  不随仓库分发的资源树（体积 / 第三方版权原因）
#  缺这些不影响编译，只影响对应功能页能否用；怎么补见 CONTRIBUTING.md 第 4 节。
# ============================================================

# 剪辑器（OpenCut）前端构建产物：约 340MB，且含 53MB 单文件模型权重 —— 产物不进版本库
app/src/main/assets/opencut/

# Mine-imator 引擎自带的资源与着色器（上游未附再分发许可）
app/src/main/assets/Data/
app/src/main/assets/Sprites/
app/src/main/assets/Compiled/
app/src/main/assets/Particles/
app/src/main/assets/Schematics/
app/src/main/assets/shader_*/
app/src/main/assets/primitive.fsh
app/src/main/assets/primitive.vsh
app/src/main/assets/world_*.fsh
app/src/main/assets/world_*.vsh

# 含第三方版权素材的页面资源
app/src/main/assets/cloudtrain/
app/src/main/assets/rhinelab/

# 第三方预编译二进制（.so）
app/src/main/jniLibs/
