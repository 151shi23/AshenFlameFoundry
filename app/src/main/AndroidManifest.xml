<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shizuku 提权：允许本应用在用户授权后通过 Shizuku 以更高权限运行 shell，
         以便读取 Minecraft 沙箱外的存档（基岩版 /Android/data/ 目录）。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- Blockbench 在线网页版加载需要网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 读取系统连通性。WebView 的 navigator.onLine 由底层 ConnectivityManager 推导，
         缺少本权限时可能恒定误报为 false，会连带影响 Blockbench 商店列表的填充
         与内置插件加载时的网络探测；同时本应用展示联网状态也需要它。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 把 Blockbench 导出的模型写入公共“下载”目录。Android 10+ 走 MediaStore 不需要权限，
         仅 Android 8/9 需要它；未授权时导出会退回应用私有目录，文件不会丢。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 「网易存档解密导出」直读公共目录里的存档需要读权限（Android 8~12）；
         13+ 该位置基本落在应用私有沙箱内，由 Shizuku 提权或“手动指定文件夹”覆盖，故上限到 32。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".MinewaysApp"
        android:label="Mineways Mobile"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MinewaysMobile"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="false"
        tools:targetApi="s">

        <!-- Shizuku 服务提供者（用于检测/连接 Shizuku） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 启动强更闸门：每次启动必须联网检查 GitHub Releases，命中关键词则不允许进入主界面 -->
        <activity
            android:name=".UpdateGateActivity"
            android:exported="true"
            android:theme="@style/Theme.MinewaysMobile"
            android:configChanges="orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode" />

        <!-- Blockbench 模型编辑器（在线 / 离线 WebView 页） -->
        <activity
            android:name=".BlockbenchActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode|keyboard|keyboardHidden"
            android:theme="@style/Theme.MinewaysMobile" />

        <!-- OBJ 自动贴图预览（全屏 WebView + 内置离线 WebGL 查看器 assets/objviewer） -->
        <activity
            android:name=".ObjPreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode|keyboard|keyboardHidden"
            android:theme="@style/Theme.MinewaysMobile" />

        <!-- PNG 转模型：纯色背景像素图逐像素转成 Blockbench 立方体，导出 .bbmodel（纯本地） -->
        <activity
            android:name=".PngToModelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|uiMode|keyboard|keyboardHidden"
            android:theme="@style/Theme.MinewaysMobile" />

        <!-- bb 模型转 OBJ：WebView 载入 assets 内置离线 Blockbench 内核做 headless 转换 -->
        <activity
            android:name=".BbToObjActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|uiMode|keyboard|keyboardHidden"
            android:theme="@style/Theme.MinewaysMobile" />

        <!-- AI 动画助手：自然语言 → 基岩版动画/粒子 JSON 与 Molang（用户自配 OpenAI 兼容 API） -->
        <activity
            android:name=".AiAnimActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|uiMode|keyboard|keyboardHidden"
            android:theme="@style/Theme.MinewaysMobile" />

        <!-- 内置小游戏《寂零快跑》（assets/minigame 下的纯静态 HTML5 跑酷，竖屏触屏操作） -->
        <activity
            android:name=".MiniGameActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|uiMode|keyboard|keyboardHidden"
            android:theme="@style/Theme.MinewaysMobile" />

        <!-- 粒子编辑器（Snowstorm 离线版 · 汉化；assets/snowstorm 下的静态站点 + 注入式汉化） -->
        <activity
            android:name=".SnowstormActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode|keyboard|keyboardHidden"
            android:theme="@style/Theme.MinewaysMobile" />

        <!-- FileProvider：供“快捷工具”等访问并打开导出/转换输出目录 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>