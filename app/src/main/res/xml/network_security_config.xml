<?xml version="1.0" encoding="utf-8"?>
<!-- 只给自建的 Sincerity 工具站放行明文 http（IP 直连、没有 HTTPS 证书）；
     其余站点一律保持系统默认（Android 9+ 默认禁明文），整体安全策略不变。

     127.0.0.1 / localhost 是例外：网页工具的流量会先到本机代理（com.mineways.net.LocalProxy），
     WebView 与它之间是明文 HTTP。这个例外只覆盖回环地址，出站流量仍是原来的策略
     （明文站点仍由 WebView 的 cleartext 检查拦着）。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">110.42.53.159</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
