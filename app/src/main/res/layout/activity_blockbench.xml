<?xml version="1.0" encoding="utf-8"?>
<!-- 建模页独占全屏：没有标题栏，网页铺满整块屏幕；进度与状态是浮在上面的覆盖层，
     不占页面高度（以前那条 LinearLayout + MaterialToolbar 会永久吃掉 actionBarSize，
     Blockbench 自己的工具栏就被顶下去一截）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_primary">

    <WebView
        android:id="@+id/bb_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/bb_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:layout_gravity="top"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bb_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="3dp"
        android:background="#E614141A"
        android:padding="8dp"
        android:visibility="gone"
        android:textColor="@color/white"
        android:textSize="12sp" />
</FrameLayout>
